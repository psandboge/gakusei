  "scripts": {
    "preflight": "node scripts/preflight.js",
    "preinstall": "npm run preflight",
    "prepare:assets": "node scripts/updateVersionFromMavenPom.js && node scripts/generateFrontendLicenses.js && node scripts/copyBootstrap.js",
    "precompile": "npm run preflight && npm run prepare:assets",
    "compile": "webpack --mode development",
    "precompile:production": "npm run preflight && NODE_ENV=production npm run prepare:assets",
    "compile:production": "webpack --mode production",
    "prestart": "npm run preflight && npm run prepare:assets",
    "start": "webpack serve --mode development",
    "pretest": "npm run preflight",
    "test": "mocha --exit --require ./mocha.bootstrap.js --timeout 10000 \"src/main/js/**/*.test.js\"",
    "test:browser": "bash scripts/test-browser.sh",
    "test:browser:spec": "playwright test"
  },
